{
  "name": "gigaid",
  "version": "1.0.0",
  "description": "DID management and verification system using Veramo",
  "main": "dist/server/app.js",
  "type": "module",
  "engines": {
    "node": "20.x",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node scripts/railway-start.js",
    "start:direct": "node --experimental-specifier-resolution=node dist/server/app.js",
    "dev": "nodemon",
    "build": "tsc && npm run copy-public",
    "copy-public": "cp -r src/public dist/",
    "test": "npm run build && concurrently \"npm run start\" \"wait-on http://localhost:3000/health && NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/test-api.ts\"",
    "test:api": "NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/test-api.ts",
    "test:flow": "NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/test-flow.ts",
    "test:registration-api": "NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/test-api-registration.ts",
    "test:eth": "NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/test-eth-transfer.ts",
    "test:hierarchy": "echo 'Removed'",
    "test:school-flow": "echo 'Removed'",
    "get-org-info": "echo 'Removed'",
    "reset-db": "NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/reset-database.ts",
    "seed-db": "NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/seed-database.ts",
    "setup": "node scripts/setup-public.js",
    "postinstall": "npm run setup"
  },
  "keywords": [
    "DID",
    "Veramo",
    "Identity",
    "Credentials"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^8.3.6",
    "@simplewebauthn/types": "^12.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express-session": "^1.18.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@veramo/core": "^5.5.3",
    "@veramo/credential-w3c": "^5.5.3",
    "@veramo/data-store": "^5.5.3",
    "@veramo/did-manager": "^5.5.3",
    "@veramo/did-provider-ethr": "^5.5.3",
    "@veramo/did-resolver": "^5.5.3",
    "@veramo/key-manager": "^5.5.3",
    "@veramo/kms-local": "^5.5.3",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "did-resolver": "^4.1.0",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "ethers": "^6.11.1",
    "@safe-global/api-kit": "^4.0.0",
    "ethr-did-resolver": "^11.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.1",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.11.24",
    "@types/node-fetch": "^2.6.12",
    "concurrently": "^8.2.2",
    "node-fetch": "^2.7.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  }
}
