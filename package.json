{
  "name": "gigaid",
  "version": "1.0.0",
  "description": "DID management and credentials verification system",
  "main": "dist/server/app.js",
  "type": "module",
  "engines": {
    "node": "20.x",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node scripts/railway-start.js",
    "start:direct": "node --experimental-specifier-resolution=node dist/server/app.js",
    "dev": "nodemon",
    "build": "tsc && npm run copy-public",
    "copy-public": "cp -r src/public dist/",
    "test": "npm run build && concurrently \"npm run start\" \"wait-on http://localhost:3000/health && NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/test-app.ts\"",
    "test:e2e": "NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/test-app.ts",
    "get-org-info": "NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/get-organization-info.ts",
    "reset-db": "node --loader ts-node/esm --experimental-specifier-resolution=node src/scripts/reset-database.ts",
    "seed-db": "NODE_OPTIONS='--loader ts-node/esm' ts-node src/scripts/seed-database.ts"
  },
  "keywords": [
    "DID",
    "Veramo",
    "Identity",
    "Credentials"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/msal-node": "^3.8.0",
    "@safe-global/api-kit": "^4.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express-session": "^1.18.1",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "envalid": "^8.0.0",
    "ethers": "^6.11.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.1",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "passport": "^0.7.0",
    "passport-azure-ad": "^4.3.5",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.11.24",
    "@types/node-fetch": "^2.6.12",
    "@types/passport": "^1.0.17",
    "concurrently": "^8.2.2",
    "node-fetch": "^2.7.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "types": "./dist/server/app.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Javiershenbc/Giga_ID.git"
  },
  "bugs": {
    "url": "https://github.com/Javiershenbc/Giga_ID/issues"
  },
  "homepage": "https://github.com/Javiershenbc/Giga_ID#readme"
}
