# Railway Environment Variables Example
# Copy these to your Railway dashboard under Variables tab

PORT=3000
NODE_ENV=production
SECRET_KEY=your-secret-key-change-in-production-railway-123
SESSION_SECRET=your-session-secret-change-in-production-railway-456
JWT_SECRET=your-super-secret-jwt-key-change-in-production-railway-789
DB_NAME=database.sqlite
DATABASE_PATH=database.sqlite
CORS_ORIGIN=*
INFURA_PROJECT_ID=
ETH_NETWORK=sepolia
PRIVATE_KEY=
ENABLE_BLOCKCHAIN=false
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX_REQUESTS=10000
RP_NAME=GigaID
RP_ID=gigaid-poc.up.railway.app 